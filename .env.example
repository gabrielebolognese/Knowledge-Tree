# Copy this file to .env and fill both values in, then run `npm run build`.
# Vite bakes VITE_* variables into the bundle at BUILD time, not at run time,
# so a rebuild is required after changing them.
#
# Find both in your Supabase project: Settings -> API.
# The anon key is meant to ship in the browser; row-level security is what
# protects the data. Keep .env out of git anyway (it already is).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
